# ── SECRETS — never committed ────────────────────────────────────────────────
# Real connection strings, JWT keys and AI API keys live in these files only.
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
# Team's cross-service config file — AddCentralConfiguration() loads it LAST,
# so it overrides everything else. Assume it carries real connection strings.
appsettings.central.json
*.env
.env
.env.*
!.env.example
secrets.json
# Firebase service-account private key shipped inside the source tree
**/Domain/Config/*firebase-adminsdk*.json
**/*-adminsdk-*.json

