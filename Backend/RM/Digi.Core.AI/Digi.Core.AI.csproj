<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.11" />

    <!--
      Generic (non-Multinet) providers have no purpose-built parsing pipeline of
      their own, so resume text has to be extracted here before it can be
      prompted. Same itext version already used by Digi.Recruitment.Module, so
      there is one PDF engine in the solution, not two.
    -->
    <PackageReference Include="itext" Version="9.5.0" />
  </ItemGroup>

  <!--
    MultinetAiProvider's wire-level helpers (status→domain error mapping,
    error-body parsing) are internal on purpose: nothing outside the provider
    should depend on the AI service's HTTP shape. They are still the
    highest-value things to test, so the test assembly gets access rather than
    the API surface being widened.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Digi.Recruitment.Module.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
